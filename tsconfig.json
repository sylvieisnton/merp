{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": [
			"bun"
		],
		"resolveJsonModule": true
	},
	"include": [
		"*.ts",
		"scripts/**/*.ts"
	]
}