{
	"name": "merp",
	"type": "module",
	"version": "0.1.1",
	"description": "minify everything really perfectly",
	"bin": {
		"merp": "./dist/tippiest.js"
	},
	"scripts": {
		"obfuscate": "bun ./tippiest.ts",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test tests/*.test.mjs",
		"build": "node ./scripts/meer.mjs",
		"prepack": "npm run build"
	},
	"dependencies": {
		"esbuild": "^0.28.2",
		"random-word": "^3.0.0",
		"ts-morph": "^28.0.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"@types/random-word": "^2.0.2",
		"playwright-core": "^1.63.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.2"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js",
			"require": "./dist/vite.cjs"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=20.19.0"
	},
	"peerDependencies": {
		"vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}